{
  "pipeline": {
    "name": "myapp-pipeline",
    "roleArn": "arn:aws:iam::345549356290:role/CodePipelineServiceRole",
    "artifactStore": {
      "type": "S3",
      "location": "myapp-artifacts-345549356290-us-east-1"
    },
    "stages": [
      {
        "name": "Source",
        "actions": [
          {
            "name": "GitHubSource",
            "actionTypeId": {
              "category": "Source",
              "owner": "AWS",
              "provider": "CodeStarSourceConnection",
              "version": "1"
            },
            "runOrder": 1,
            "configuration": {
              "ConnectionArn": "arn:aws:codestar-connections:us-east-1:345549356290:connection/996c9c53-5bd2-4d6a-9a60-98a638a98596",
              "FullRepositoryId": "mureithi111/myapp",
              "BranchName": "main",
              "OutputArtifactFormat": "CODE_ZIP",
              "DetectChanges": "true"
            },
            "outputArtifacts": [{"name": "SourceArtifact"}],
            "inputArtifacts": [],
            "region": "us-east-1",
            "namespace": "SourceVariables"
          }
        ]
      },
      {
        "name": "Build",
        "actions": [
          {
            "name": "BuildAndTest",
            "actionTypeId": {
              "category": "Build",
              "owner": "AWS",
              "provider": "CodeBuild",
              "version": "1"
            },
            "runOrder": 1,
            "configuration": {
              "ProjectName": "myapp-build"
            },
            "inputArtifacts": [{"name": "SourceArtifact"}],
            "outputArtifacts": [{"name": "BuildArtifact"}],
            "region": "us-east-1"
          }
        ]
      },
      {
        "name": "Approval",
        "actions": [
          {
            "name": "ApproveProductionRelease",
            "actionTypeId": {
              "category": "Approval",
              "owner": "AWS",
              "provider": "Manual",
              "version": "1"
            },
            "runOrder": 1,
            "configuration": {
              "CustomData": "Approve only after the CodeBuild health test succeeds."
            },
            "inputArtifacts": [],
            "outputArtifacts": []
          }
        ]
      },
      {
        "name": "Deploy",
        "actions": [
          {
            "name": "ECSBlueGreenDeployment",
            "actionTypeId": {
              "category": "Deploy",
              "owner": "AWS",
              "provider": "CodeDeployToECS",
              "version": "1"
            },
            "runOrder": 1,
            "configuration": {
              "ApplicationName": "myapp-codedeploy",
              "DeploymentGroupName": "myapp-deployment-group",
              "TaskDefinitionTemplateArtifact": "SourceArtifact",
              "TaskDefinitionTemplatePath": "taskdef.json",
              "AppSpecTemplateArtifact": "SourceArtifact",
              "AppSpecTemplatePath": "appspec.yml",
              "Image1ArtifactName": "BuildArtifact",
              "Image1ContainerName": "myapp-container"
            },
            "inputArtifacts": [
              {"name": "SourceArtifact"},
              {"name": "BuildArtifact"}
            ],
            "outputArtifacts": [],
            "region": "us-east-1"
          }
        ]
      }
    ],
    "version": 1
  }
}
